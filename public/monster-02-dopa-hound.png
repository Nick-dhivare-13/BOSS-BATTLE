<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#3b1d54"/>
      <stop offset="35%" stop-color="#6b3a82"/>
      <stop offset="70%" stop-color="#9d6eb0"/>
      <stop offset="100%" stop-color="#c4a5d4"/>
    </linearGradient>

    <linearGradient id="mountainGrad1" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4a2561" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#7e4c96" stop-opacity="0.6"/>
    </linearGradient>

    <linearGradient id="mountainGrad2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#2d133d" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#552c6e" stop-opacity="0.8"/>
    </linearGradient>

    <filter id="redLightningGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur in="SourceGraphic" stdDeviation="6" result="blur1"/>
      <feGaussianBlur in="SourceGraphic" stdDeviation="14" result="blur2"/>
      <feMerge>
        <feMergeNode in="blur2"/>
        <feMergeNode in="blur1"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <filter id="intenseRedGlow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>

    <linearGradient id="ashenSkin" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#f1f5f9"/>
      <stop offset="60%" stop-color="#cbd5e1"/>
      <stop offset="100%" stop-color="#94a3b8"/>
    </linearGradient>

    <linearGradient id="boneBladeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="50%" stop-color="#e2e8f0"/>
      <stop offset="100%" stop-color="#cbd5e1"/>
    </linearGradient>

    <linearGradient id="roofGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1e1b4b"/>
      <stop offset="60%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#020617"/>
    </linearGradient>
  </defs>

  <rect width="1200" height="675" fill="url(#skyGrad)"/>

  <path d="M 0,260 Q 200,160 400,240 T 800,210 T 1200,250 L 1200,675 L 0,675 Z" fill="url(#mountainGrad1)"/>
  <path d="M 0,330 Q 250,230 500,310 T 1000,280 T 1200,340 L 1200,675 L 0,675 Z" fill="url(#mountainGrad2)"/>

  <g fill="#18122B" opacity="0.85">
    <polygon points="20,440 90,390 160,440 140,540 40,540"/>
    <polygon points="120,450 190,400 260,450 240,560 140,560"/>
    <polygon points="60,510 140,460 220,510 200,620 80,620"/>
    <polygon points="0,540 80,490 160,540 140,660 0,660"/>

    <polygon points="1040,440 1110,390 1180,440 1160,540 1060,540"/>
    <polygon points="940,450 1010,400 1080,450 1060,560 960,560"/>
    <polygon points="980,510 1060,460 1140,510 1120,620 1000,620"/>
    <polygon points="1040,540 1120,490 1200,540 1200,660 1060,660"/>
  </g>

  <!-- Rooftop Foreground -->
  <g fill="url(#roofGrad)" stroke="#334155" stroke-width="2">
    <path d="M 160,620 Q 380,550 600,530 Q 820,550 1040,620 L 1080,675 L 120,675 Z" fill="#1e1b2e" stroke="#475569"/>
    <path d="M 600,530 L 600,675" stroke="#64748b" stroke-width="8"/>
    <path d="M 520,538 L 460,675" stroke="#334155" stroke-width="5"/>
    <path d="M 680,538 L 740,675" stroke="#334155" stroke-width="5"/>
    <path d="M 440,552 L 320,675" stroke="#1e293b" stroke-width="5"/>
    <path d="M 760,552 L 880,675" stroke="#1e293b" stroke-width="5"/>
  </g>

  <!-- RED CURSED ENERGY LIGHTNING ARCS -->
  <g filter="url(#redLightningGlow)">
    <path d="M 600,160 L 540,110 L 560,95 L 490,40 L 515,65 L 430,30 L 460,80 L 390,70 L 430,120 L 330,150 L 390,175 L 290,230 L 340,240 L 260,340 L 320,320 L 250,440 L 310,400 L 220,540 L 270,490 L 300,580 L 360,520 L 400,600" fill="#ff0044" stroke="#ff0033" stroke-width="3"/>
    <path d="M 600,160 L 660,110 L 640,95 L 710,40 L 685,65 L 770,30 L 740,80 L 810,70 L 770,120 L 870,150 L 810,175 L 910,230 L 860,240 L 940,340 L 880,320 L 950,440 L 890,400 L 980,540 L 930,490 L 900,580 L 840,520 L 800,600" fill="#ff0044" stroke="#ff0033" stroke-width="3"/>
    <polygon points="410,220 360,180 390,200 340,150 400,190 380,240" fill="#ffffff"/>
    <polygon points="790,220 840,180 810,200 860,150 800,190 820,240" fill="#ffffff"/>
  </g>

  <!-- SIX-ARMED CURSED WARRIOR -->
  <g>
    <!-- Shadow Kilt / Hakama Skirt -->
    <path d="M 525,370 L 470,420 L 440,480 L 490,460 L 460,540 L 515,500 L 530,590 L 570,510 L 600,560 L 630,510 L 670,590 L 685,500 L 740,540 L 710,460 L 760,480 L 730,420 L 675,370 Z" fill="#1c1917" stroke="#0c0a09" stroke-width="2"/>

    <!-- Ashen Legs -->
    <path d="M 535,460 Q 485,510 470,570 Q 455,620 480,660 L 510,670 L 525,650 L 505,625 L 535,560 L 565,490 Z" fill="url(#ashenSkin)" stroke="#334155" stroke-width="2"/>
    <path d="M 665,460 Q 715,510 730,570 Q 745,620 720,660 L 690,670 L 675,650 L 695,625 L 665,560 L 635,490 Z" fill="url(#ashenSkin)" stroke="#334155" stroke-width="2"/>

    <!-- Muscular Ashen Torso -->
    <path d="M 535,210 L 510,280 L 525,375 L 600,400 L 675,375 L 690,280 L 665,210 Z" fill="url(#ashenSkin)" stroke="#334155" stroke-width="2"/>

    <!-- SIX ARMS holding bone daggers / jagged blades -->
    <path d="M 540,220 Q 450,180 390,220 L 360,250 L 380,260 L 420,240 Q 480,220 545,250 Z" fill="url(#ashenSkin)" stroke="#334155" stroke-width="2"/>
    <path d="M 660,220 Q 750,150 780,100 L 810,120 L 780,170 Q 730,220 655,250 Z" fill="url(#ashenSkin)" stroke="#334155" stroke-width="2"/>

    <path d="M 525,265 Q 430,270 360,330 L 340,310 L 370,280 Q 450,240 525,250 Z" fill="url(#ashenSkin)" stroke="#334155" stroke-width="2"/>
    <path d="M 675,265 Q 770,270 840,330 L 860,310 L 830,280 Q 750,240 675,250 Z" fill="url(#ashenSkin)" stroke="#334155" stroke-width="2"/>

    <path d="M 525,320 Q 470,360 410,430 L 390,410 L 430,350 Q 480,310 535,300 Z" fill="url(#ashenSkin)" stroke="#334155" stroke-width="2"/>
    <path d="M 675,320 Q 730,360 790,430 L 810,410 L 770,350 Q 720,310 665,300 Z" fill="url(#ashenSkin)" stroke="#334155" stroke-width="2"/>

    <!-- Blades -->
    <path d="M 370,230 L 320,130 Q 340,170 360,200 Z" fill="url(#boneBladeGrad)" stroke="#475569" stroke-width="2"/>
    <path d="M 770,120 L 710,40 Q 690,30 670,40 L 720,70 L 790,140 Z" fill="url(#boneBladeGrad)" stroke="#475569" stroke-width="2"/>
    <path d="M 350,320 L 260,370 Q 300,345 330,330 Z" fill="url(#boneBladeGrad)" stroke="#475569" stroke-width="2"/>
    <path d="M 850,320 L 940,370 Q 900,345 870,330 Z" fill="url(#boneBladeGrad)" stroke="#475569" stroke-width="2"/>
    <path d="M 400,420 L 310,450 Q 355,430 380,415 Z" fill="url(#boneBladeGrad)" stroke="#475569" stroke-width="2"/>
    <path d="M 800,420 L 890,450 Q 845,430 820,415 Z" fill="url(#boneBladeGrad)" stroke="#475569" stroke-width="2"/>

    <!-- Head & Spiky Hair -->
    <path d="M 570,140 Q 600,125 630,140 L 625,185 L 600,215 L 575,185 Z" fill="url(#ashenSkin)" stroke="#334155" stroke-width="2"/>
    <path d="M 600,50 L 620,25 L 630,60 L 655,40 L 650,80 L 680,70 L 665,110 L 695,120 L 660,140 L 675,170 L 640,165 L 645,185 L 600,165 L 555,185 L 560,165 L 525,170 L 540,140 L 505,120 L 535,110 L 520,70 L 550,80 L 545,40 L 570,60 L 580,25 Z" fill="#1c1917" stroke="#000000" stroke-width="2"/>

    <!-- Red Cursed Marks -->
    <g filter="url(#intenseRedGlow)" fill="#ff0033" stroke="#ff0033">
      <polygon points="582,150 594,154 582,158 576,154" fill="#ffffff" stroke="#ff0033" stroke-width="2"/>
      <polygon points="618,150 606,154 618,158 624,154" fill="#ffffff" stroke="#ff0033" stroke-width="2"/>

      <path d="M 560,250 L 585,250 L 585,280 L 570,310 L 560,300 Z"/>
      <path d="M 640,250 L 615,250 L 615,280 L 630,310 L 640,300 Z"/>
      <circle cx="480" cy="220" r="14" fill="none" stroke-width="4"/>
      <circle cx="720" cy="180" r="14" fill="none" stroke-width="4"/>
      <circle cx="440" cy="275" r="12" fill="none" stroke-width="4"/>
      <circle cx="760" cy="275" r="12" fill="none" stroke-width="4"/>
    </g>
  </g>
</svg>
